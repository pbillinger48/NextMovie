# ---------------------------------------------------------------------------
# NextMovie web — local environment template
#
# Copy to `.env.local` and fill in:
#     cp apps/web/.env.example apps/web/.env.local
#
# These live HERE, not in the repository root. Next.js reads env files from its
# own project directory, so a value in the root `.env` never reaches this app.
# ---------------------------------------------------------------------------

# Base URL of the ASP.NET API. NEXT_PUBLIC_ vars are exposed to the browser, so
# never put a secret behind that prefix. Defaults to http://localhost:5080 in
# code if unset.
NEXT_PUBLIC_API_BASE_URL=http://localhost:5080

# Encrypts the session cookie the Next.js tier holds on the browser's behalf
# (ADR-0004). At least 32 characters. Sign-in throws without it.
#
#     openssl rand -base64 32
SESSION_COOKIE_PASSWORD=

# --- Google sign-in (optional) ----------------------------------------------
# Only needed to exercise the Google button; everything else runs without them.
#
# Create a Web application OAuth client at
# https://console.cloud.google.com/apis/credentials and register the redirect URI
# below. GOOGLE_CLIENT_ID must also appear in the API's Google:ClientIds — the web
# tier obtains the token, the API decides whose tokens it trusts.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback
