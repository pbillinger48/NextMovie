<Project Sdk="Microsoft.NET.Sdk.Web">

  <!-- Common properties live in ../Directory.Build.props -->

  <PropertyGroup>
    <UserSecretsId>be5af9c8-ec18-48b3-897e-e06a7332b1c8</UserSecretsId>

    <!--
      Emit the OpenAPI document to packages/api-client during build.

      ADR-0002 makes this schema the single source of truth for the TypeScript
      client. Generating it at build time rather than scraping /openapi/v1.json
      from a running server means CI can verify the contract without booting the
      API or a database — which is what lets the drift check be a hard gate.
    -->
    <OpenApiGenerateDocumentsOnBuild>true</OpenApiGenerateDocumentsOnBuild>
    <OpenApiDocumentsDirectory>$(MSBuildProjectDirectory)/../../../packages/api-client</OpenApiDocumentsDirectory>
  </PropertyGroup>

  <ItemGroup>
    <!--
      TMDb DTOs, the mapper and MovieCatalog are internal so the anti-corruption
      boundary is enforced by the compiler rather than by convention. Tests still
      need to reach them, which is exactly what this is for.
    -->
    <InternalsVisibleTo Include="NextMovie.Api.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!--
      Letterboxd exports are CSV, and film titles contain commas, quotes and
      non-ASCII characters ("Crouching Tiger, Hidden Dragon", "WALL-E").
      Hand-rolling a parser to avoid a dependency is a false economy: the failure
      mode is not a crash but silently mis-split rows, which would attach a rating
      to the wrong film.
    -->
    <PackageReference Include="CsvHelper" Version="33.1.0" />
    <PackageReference Include="EFCore.NamingConventions" Version="10.0.1" />
    <!--
      Token validation, per ADR-0003: verifying a JWT signature is a
      cryptographic operation and is exactly the line that ADR says not to
      cross by hand. Issuing uses Microsoft.IdentityModel.JsonWebTokens, which
      arrives with this package.

      PasswordHasher<T> needs no reference at all — Microsoft.Extensions.Identity.Core
      is part of the ASP.NET Core shared framework. Notably this is NOT
      Microsoft.AspNetCore.Identity.EntityFrameworkCore, which is what would
      bring the AspNet* tables ADR-0003 rejects.
    -->
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.11" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.11" />

    <!--
      Pinned explicitly, though both arrive transitively. Microsoft.EntityFrameworkCore.Design
      is PrivateAssets=all, so it raises EF Core to 10.0.11 inside this project but does not
      flow to referencing projects. Consumers (NextMovie.Api.Tests) would otherwise resolve
      10.0.4 via Npgsql/NamingConventions while linking an assembly built against 10.0.11 —
      an MSB3277 conflict that becomes a runtime TypeLoadException under TreatWarningsAsErrors.
    -->
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="10.0.11" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" Version="10.0.11" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.11">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.Extensions.ApiDescription.Server" Version="10.0.11">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.Extensions.Http.Resilience" Version="10.9.0" />

    <!--
      Google's OpenID Connect discovery document and JWKS, per ADR-0005. Used for
      its ConfigurationManager, which caches the signing keys and refetches them
      when Google rotates - the part that would be easy to write and easy to get
      wrong, since a stale key set means every sign-in fails until a restart.
      Arrives transitively with JwtBearer; pinned explicitly because we call it
      directly.
    -->
    <PackageReference Include="Microsoft.IdentityModel.Protocols.OpenIdConnect" Version="8.22.0" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.3" />
  </ItemGroup>

</Project>
