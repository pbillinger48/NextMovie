{
  "openapi": "3.1.1",
  "info": {
    "title": "NextMovie.Api | v1",
    "version": "1.0.0"
  },
  "paths": {
    "/api/v1/health": {
      "get": {
        "tags": [
          "GetHealth"
        ],
        "summary": "Liveness probe",
        "description": "Reports whether the API process is running and serving requests.",
        "operationId": "GetHealth",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/movies/search": {
      "get": {
        "tags": [
          "SearchMovies"
        ],
        "summary": "Search films by title",
        "description": "Searches TMDb by title, stores the results in the NextMovie catalogue, and returns them ranked by relevance.",
        "operationId": "SearchMovies",
        "parameters": [
          {
            "name": "title",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "page",
            "in": "query",
            "schema": {
              "pattern": "^-?(?:0|[1-9]\\d*)$",
              "type": "integer",
              "format": "int32"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SearchMoviesResponse"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/HttpValidationProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/movies/{id}": {
      "get": {
        "tags": [
          "GetMovieDetails"
        ],
        "summary": "Get a film",
        "description": "Returns a film from the NextMovie catalogue, enriching it from TMDb when its details are missing or stale.",
        "operationId": "GetMovieDetails",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MovieDetails"
                }
              }
            }
          },
          "404": {
            "description": "Not Found",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/auth/register": {
      "post": {
        "tags": [
          "RegisterUser"
        ],
        "summary": "Create an account",
        "description": "Creates a new account with an email and password, and returns an access token and refresh token for the new session.",
        "operationId": "RegisterUser",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RegisterUserRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "Created",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthenticationResponse"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/HttpValidationProblemDetails"
                }
              }
            }
          },
          "409": {
            "description": "Conflict",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/auth/login": {
      "post": {
        "tags": [
          "LoginUser"
        ],
        "summary": "Sign in",
        "description": "Exchanges an email and password for an access token and refresh token. Repeated failures temporarily lock the account.",
        "operationId": "LoginUser",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginUserRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthenticationResponse"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/HttpValidationProblemDetails"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/auth/refresh": {
      "post": {
        "tags": [
          "RefreshSession"
        ],
        "summary": "Refresh a session",
        "description": "Exchanges a refresh token for a new access token and a new refresh token. The presented token is revoked; presenting it again ends the session.",
        "operationId": "RefreshSession",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RefreshSessionRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthenticationResponse"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/HttpValidationProblemDetails"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/auth/logout": {
      "post": {
        "tags": [
          "LogoutUser"
        ],
        "summary": "Sign out",
        "description": "Revokes the session the refresh token belongs to. Always succeeds, whether or not the token was still valid.",
        "operationId": "LogoutUser",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LogoutUserRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "204": {
            "description": "No Content"
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/HttpValidationProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/auth/google": {
      "post": {
        "tags": [
          "SignInWithGoogle"
        ],
        "summary": "Sign in with Google",
        "description": "Verifies a Google ID token and returns a NextMovie session, creating an account or linking the Google identity to an existing one.",
        "operationId": "SignInWithGoogle",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SignInWithGoogleRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthenticationResponse"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/HttpValidationProblemDetails"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "403": {
            "description": "Forbidden",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/users/me": {
      "get": {
        "tags": [
          "GetCurrentUser"
        ],
        "summary": "Get the signed-in user's profile",
        "description": "Returns the profile of the account the access token belongs to.",
        "operationId": "GetCurrentUser",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UserProfileResponse"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      },
      "put": {
        "tags": [
          "UpdateCurrentUser"
        ],
        "summary": "Update the signed-in user's profile",
        "description": "Replaces the editable parts of the profile. Fields omitted from the request are cleared.",
        "operationId": "UpdateCurrentUser",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UpdateCurrentUserRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UserProfileResponse"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/HttpValidationProblemDetails"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "AuthenticatedUser": {
        "required": [
          "id",
          "email",
          "displayName",
          "profileImageUrl"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "NextMovie user identifier.",
            "format": "uuid"
          },
          "email": {
            "type": "string",
            "description": "Email address, as the user entered it."
          },
          "displayName": {
            "type": "string",
            "description": "Name to show in the UI."
          },
          "profileImageUrl": {
            "type": [
              "null",
              "string"
            ],
            "description": "Avatar URL, when one is set."
          }
        },
        "description": "The account a session belongs to."
      },
      "AuthenticationResponse": {
        "required": [
          "accessToken",
          "accessTokenExpiresAt",
          "refreshToken",
          "refreshTokenExpiresAt",
          "user"
        ],
        "type": "object",
        "properties": {
          "accessToken": {
            "type": "string",
            "description": "Bearer token for API calls. Send as `Authorization: Bearer {token}`."
          },
          "accessTokenExpiresAt": {
            "type": "string",
            "description": "When the access token stops being accepted.",
            "format": "date-time"
          },
          "refreshToken": {
            "type": "string",
            "description": "Opaque token used to obtain a new access token. Store it as securely as a password."
          },
          "refreshTokenExpiresAt": {
            "type": "string",
            "description": "When the refresh token stops being exchangeable.",
            "format": "date-time"
          },
          "user": {
            "description": "The signed-in account.",
            "$ref": "#/components/schemas/AuthenticatedUser"
          }
        },
        "description": "A newly established session."
      },
      "HealthResponse": {
        "required": [
          "status",
          "version",
          "timestampUtc"
        ],
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "description": "Always `healthy` when the process is serving requests."
          },
          "version": {
            "type": "string",
            "description": "Informational assembly version of the running build."
          },
          "timestampUtc": {
            "type": "string",
            "description": "Server time at which the probe was answered.",
            "format": "date-time"
          }
        },
        "description": "Response body returned by the health endpoint."
      },
      "HttpValidationProblemDetails": {
        "type": "object",
        "properties": {
          "type": {
            "type": [
              "null",
              "string"
            ]
          },
          "title": {
            "type": [
              "null",
              "string"
            ]
          },
          "status": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "null",
              "integer"
            ],
            "format": "int32"
          },
          "detail": {
            "type": [
              "null",
              "string"
            ]
          },
          "instance": {
            "type": [
              "null",
              "string"
            ]
          },
          "errors": {
            "type": "object",
            "additionalProperties": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        }
      },
      "LoginUserRequest": {
        "required": [
          "email",
          "password"
        ],
        "type": "object",
        "properties": {
          "email": {
            "type": [
              "null",
              "string"
            ],
            "description": "Email address the account was registered with. Case-insensitive."
          },
          "password": {
            "type": [
              "null",
              "string"
            ],
            "description": "The account's password."
          }
        },
        "description": "Credentials presented at sign-in."
      },
      "LogoutUserRequest": {
        "required": [
          "refreshToken"
        ],
        "type": "object",
        "properties": {
          "refreshToken": {
            "type": [
              "null",
              "string"
            ],
            "description": "The refresh token held by the client signing out."
          }
        },
        "description": "The session to end."
      },
      "MovieDetails": {
        "required": [
          "id",
          "tmdbId",
          "title",
          "originalTitle",
          "overview",
          "posterPath",
          "backdropPath",
          "releaseDate",
          "runtime",
          "averageRating",
          "popularity",
          "language",
          "status",
          "genres"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "NextMovie identifier.",
            "format": "uuid"
          },
          "tmdbId": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": "integer",
            "description": "TMDb identifier, exposed for attribution and deep links.",
            "format": "int32"
          },
          "title": {
            "type": "string",
            "description": "Display title."
          },
          "originalTitle": {
            "type": [
              "null",
              "string"
            ],
            "description": "Title in the original language, when it differs."
          },
          "overview": {
            "type": [
              "null",
              "string"
            ],
            "description": "Synopsis, when TMDb has one."
          },
          "posterPath": {
            "type": [
              "null",
              "string"
            ],
            "description": "Relative TMDb poster path; combine with a TMDb image base URL to render."
          },
          "backdropPath": {
            "type": [
              "null",
              "string"
            ],
            "description": "Relative TMDb backdrop path."
          },
          "releaseDate": {
            "type": [
              "null",
              "string"
            ],
            "description": "Release date, when known.",
            "format": "date"
          },
          "runtime": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "null",
              "integer"
            ],
            "description": "Runtime in minutes. Null when TMDb does not know it.",
            "format": "int32"
          },
          "averageRating": {
            "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d+)?(?:[eE][+-]?\\d+)?$",
            "type": [
              "null",
              "number"
            ],
            "description": "TMDb community rating 0–10. Null when the film has no votes.",
            "format": "double"
          },
          "popularity": {
            "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d+)?(?:[eE][+-]?\\d+)?$",
            "type": [
              "null",
              "number"
            ],
            "description": "TMDb popularity score. Only meaningful compared against other films.",
            "format": "double"
          },
          "language": {
            "type": [
              "null",
              "string"
            ],
            "description": "ISO 639-1 code of the original language."
          },
          "status": {
            "type": [
              "null",
              "string"
            ],
            "description": "TMDb release status, e.g. `Released`."
          },
          "genres": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Genre names, alphabetically."
          }
        },
        "description": "Everything the catalogue holds about a film."
      },
      "MovieSummary": {
        "required": [
          "id",
          "tmdbId",
          "title",
          "overview",
          "posterPath",
          "releaseDate",
          "averageRating",
          "genres"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "NextMovie identifier. Stable, and the one clients should store.",
            "format": "uuid"
          },
          "tmdbId": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": "integer",
            "description": "TMDb identifier, exposed for attribution and deep links.",
            "format": "int32"
          },
          "title": {
            "type": "string",
            "description": "Display title."
          },
          "overview": {
            "type": [
              "null",
              "string"
            ],
            "description": "Synopsis, when TMDb has one."
          },
          "posterPath": {
            "type": [
              "null",
              "string"
            ],
            "description": "Relative TMDb poster path; combine with a TMDb image base URL to render."
          },
          "releaseDate": {
            "type": [
              "null",
              "string"
            ],
            "description": "Release date, when known.",
            "format": "date"
          },
          "averageRating": {
            "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d+)?(?:[eE][+-]?\\d+)?$",
            "type": [
              "null",
              "number"
            ],
            "description": "TMDb community rating 0–10. Null when the film has no votes.",
            "format": "double"
          },
          "genres": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Genre names, alphabetically."
          }
        },
        "description": "Summary view of a film."
      },
      "ProblemDetails": {
        "type": "object",
        "properties": {
          "type": {
            "type": [
              "null",
              "string"
            ]
          },
          "title": {
            "type": [
              "null",
              "string"
            ]
          },
          "status": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "null",
              "integer"
            ],
            "format": "int32"
          },
          "detail": {
            "type": [
              "null",
              "string"
            ]
          },
          "instance": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      },
      "RefreshSessionRequest": {
        "required": [
          "refreshToken"
        ],
        "type": "object",
        "properties": {
          "refreshToken": {
            "type": [
              "null",
              "string"
            ],
            "description": "The refresh token issued by register, login, or a previous refresh."
          }
        },
        "description": "The refresh token to exchange."
      },
      "RegisterUserRequest": {
        "required": [
          "email",
          "displayName",
          "password"
        ],
        "type": "object",
        "properties": {
          "email": {
            "type": [
              "null",
              "string"
            ],
            "description": "Email address. Must be unique, ignoring case."
          },
          "displayName": {
            "type": [
              "null",
              "string"
            ],
            "description": "Name to show in the UI."
          },
          "password": {
            "type": [
              "null",
              "string"
            ],
            "description": "Chosen password. See PasswordPolicy for the rules."
          }
        },
        "description": "Details needed to create an account."
      },
      "SearchMoviesResponse": {
        "required": [
          "page",
          "totalPages",
          "totalResults",
          "results"
        ],
        "type": "object",
        "properties": {
          "page": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": "integer",
            "description": "The page returned.",
            "format": "int32"
          },
          "totalPages": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": "integer",
            "description": "Total pages available for this query.",
            "format": "int32"
          },
          "totalResults": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": "integer",
            "description": "Total matching films.",
            "format": "int32"
          },
          "results": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/MovieSummary"
            },
            "description": "Films on this page, ordered by relevance."
          }
        },
        "description": "A page of search results."
      },
      "SignInWithGoogleRequest": {
        "required": [
          "idToken"
        ],
        "type": "object",
        "properties": {
          "idToken": {
            "type": [
              "null",
              "string"
            ],
            "description": "An ID token obtained by the client from Google."
          }
        },
        "description": "The Google ID token to sign in with."
      },
      "UpdateCurrentUserRequest": {
        "required": [
          "displayName",
          "profileImageUrl"
        ],
        "type": "object",
        "properties": {
          "displayName": {
            "type": [
              "null",
              "string"
            ],
            "description": "Name to show in the UI. Required."
          },
          "profileImageUrl": {
            "type": [
              "null",
              "string"
            ],
            "description": "Absolute http or https avatar URL. Omit or send null to clear it."
          }
        },
        "description": "The new state of the editable profile."
      },
      "UserProfileResponse": {
        "required": [
          "id",
          "email",
          "displayName",
          "profileImageUrl",
          "createdAt"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "NextMovie user identifier.",
            "format": "uuid"
          },
          "email": {
            "type": "string",
            "description": "Email address, as the user entered it."
          },
          "displayName": {
            "type": "string",
            "description": "Name shown in the UI."
          },
          "profileImageUrl": {
            "type": [
              "null",
              "string"
            ],
            "description": "Avatar URL, when one is set."
          },
          "createdAt": {
            "type": "string",
            "description": "When the account was created.",
            "format": "date-time"
          }
        },
        "description": "A user's own profile."
      }
    }
  },
  "tags": [
    {
      "name": "GetHealth"
    },
    {
